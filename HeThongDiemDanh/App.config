<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<add name="DefaultConnection"
			 connectionString="Data Source=LAPTOP-C89E79KQ\SQLEXPRESS;Initial Catalog=QlyDiemDanh;User ID=AdminApp;Password=admin123;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=False;"
			 providerName="Microsoft.Data.SqlClient" />
	</connectionStrings>

	<appSettings>
		<add key="TestMode"               value="true"  /><!-- true = bỏ qua kiểm tra IP khi test 1 máy -->
		<add key="ThoiGianDemNguoc"       value="10"    /><!-- Phút đếm ngược mặc định -->
		<add key="GioiHanTuDongDongPhien" value="240"   /><!-- Phút: tự đóng phiên sau 4 giờ -->

		<!-- TV4 – Ngưỡng quy đổi điểm chuyên cần (%) -->
		<add key="Nguong90"            value="90" /><!-- >= 90% → 10 điểm -->
		<add key="Nguong80"            value="80" /><!-- >= 80% → 9  điểm -->
		<add key="Nguong70"            value="70" /><!-- >= 70% → 8  điểm; 50-69% → 6 -->
		<add key="NguongCanhBaoCamThi" value="80" /><!-- Dưới đây → cảnh báo -->
		<add key="NguongCamThi"        value="50" /><!-- Dưới đây → 0 điểm, cấm thi -->
	</appSettings>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
</configuration>
