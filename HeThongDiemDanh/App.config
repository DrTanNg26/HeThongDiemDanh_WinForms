<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<add name="DefaultConnection"
			 connectionString="Data Source=BTHANG\SQLEXPRESS;Initial Catalog=QlyDiemDanh;User ID=AdminApp;Password=admin123;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=False;"
			 providerName="Microsoft.Data.SqlClient" />
	</connectionStrings>

	<!-- Cấu hình nghiệp vụ dùng chung cho cả nhóm -->
	<appSettings>
		<add key="TestMode"               value="true"  />
		<!-- true = bỏ qua kiểm tra IP khi test 1 máy -->
		<add key="ThoiGianDemNguoc"       value="10"    />
		<!-- Phút đếm ngược mặc định -->
		<add key="GioiHanTuDongDongPhien" value="240"   />
		<!-- Phút: tự đóng phiên sau 4 tiếng -->
		<add key="NguongCanhBaoCamThi"    value="80"    />
		<!-- % chuyên cần dưới ngưỡng này = cảnh báo -->
		<add key="NguongCamThi"           value="50"    />
		<!-- % dưới ngưỡng này = cấm thi, 0 điểm -->
	</appSettings>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
</configuration>